import java.io.File;
import java.io.FileNotFoundException;
import java.util.InputMismatchException;
import java.util.Scanner;

/**
 * The FormatChecker class evaluates the format of one or more input files,
 * as specified in the command-line arguments. Each file that is in the correct
 * format is declared VALID. Each file that is not in the correct format is
 * declared INVALID. All files passed in as command-line arguments are
 * evaluated and reported on at the end of the program.
 * 
 * A valid format contains two whitespace-separated, positive integers in the
 * first row, specifying the number of rows and columns in a grid. Each
 * subsequent row represents one row of the grid and should contain exactly one
 * whitespace-separated double value for each grid column. For example:
 * 
 *      3 4
 *      2 4.7 -2
 *      44 3.7 6
 *      7.4 9 0
 * 
 * An invalid file format is declared if the file cannot be found, if the
 * values don't match the expected data types, or if there are fewer or more
 * rows and/or columns of data than specified in the first row. The program
 * displays a short explanation why it is invalid, either by an exception
 * thrown while parsing, or a formatting problem discovered by a condition
 * check.
 * 
 * This program runs from the command line using the following format:
 *      $ java FormatChecker file1 [file2 ... fileN]
 * where the names of one or more input files are given.
 * 
 * @author Amanda Halverson
 * 
 */

public class FormatChecker {

    /**
     * 
     * 
     * @param args from command-line
     * @throws FileNotFoundException if the file is not found
     * @throws InPutMismatchException if the format of the data is incorrect
     */
    public static void main(String[] args) {
        String filename = "";
        String result = "";

        if (args.length == 0) {
            System.out.print("Usage: $ java FormatChecker file1 [file2 ... fileN]");
        }

        for (int i = 0; i < args.length; i++) {
            int rowsExpected = 0;
            int colsExpected = 0;
            int colTotal = 0;
            int rowTotal = 0;

            try {
                filename = args[i];
                File file = new File(args[i]);
                
                Scanner dimensionScan = new Scanner(file);
                rowsExpected = dimensionScan.nextInt();
                colsExpected = dimensionScan.nextInt();
                if (dimensionScan.hasNextInt()) {

                }
                
                while (dimensionScan.hasNextLine()) {
                    colTotal = 0;
                    Scanner lineScan = new Scanner(dimensionScan.nextLine());
                        while (lineScan.hasNextDouble()) {
                            double countColumns = lineScan.nextDouble();
                            colTotal++;
                        }
                    if (colTotal == colsExpected) {
                        rowTotal++;
                    }
                    else {
                        System.out.println("The number of columns does not match the expected number.\n");
                        result = "INVALID";
                    }
                    lineScan.close();
                }
                if (rowTotal != rowsExpected) {
                    System.out.println("The number of rows does not match the expected number.");
                }
                if ((colTotal == colsExpected) && (rowTotal == rowsExpected)) {
                    result = "VALID";
                }
                System.out.println(filename);
                dimensionScan.close();
            } catch (FileNotFoundException e) {
                System.out.println(filename);
                result = "INVALID";
                System.out.println(e.toString());
            } catch (InputMismatchException e) {
                result = "INVALD";
                System.out.println(e.toString());
            } finally {
                // if (dimensionScan != null) {
                //     dimensionScan.close();
                // }
                System.out.println(result + "\n\n");
                System.out.println("Rows expected: " + rowsExpected);
                System.out.println("Cols expected: " + colsExpected);
                System.out.println("Col total: " + colTotal);
                System.out.println("Row total: " + rowTotal);
            }
        }
    }
}